# Nutri-ID — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control!

# ── Rust Backend ─────────────────────────────────────
# SQLite path (Docker uses /app/data/nutriid.db mounted on the sqlite-data volume)
DATABASE_URL=sqlite:./data/nutriid.db?mode=rwc
RUST_LOG=info

# Set to "production" to enforce JWT_SECRET requirement
RUST_ENV=development

# Use a long random secret (e.g. openssl rand -hex 64)
JWT_SECRET=a_very_long_random_secret_at_least_64_chars_long_change_me

# Allowed CORS origin in production (your frontend domain)
ALLOWED_ORIGIN=https://nutriid.ci

# ── AI (Claude / Anthropic) ──────────────────────────
# Anthropic API key — https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Blockchain / Polygon ─────────────────────────────
# Amoy testnet = 80002, Polygon mainnet = 137
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002
# Server-side relayer wallet private key (hex, no 0x prefix)
RELAYER_PRIVATE_KEY=your_relayer_private_key_here
# Deployed HealthID SBT contract address (update after: npx hardhat run scripts/deploy.js)
HEALTH_ID_CONTRACT_ADDRESS=0xYourContractAddressHere

# ── IPFS / Pinata ────────────────────────────────────
# Create a free account at https://pinata.cloud — API Keys section
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_api_key

# ── Frontend (Vite) ──────────────────────────────────
# Leave empty in production with Nginx reverse-proxy (proxied via /api/*)
# Sur Railway : renseigner l'URL publique du service backend Railway (build-time ARG)
#   VITE_API_URL=https://nutriid-backend.up.railway.app
# En dev local le proxy Vite prend en charge /api → laisser vide
VITE_API_URL=

# ── SSL / Production Domain ──────────────────────────
DOMAIN=nutriid.ci

# ── GitHub Actions Secrets (set in Settings → Secrets, not here) ─────────────
# DEPLOY_HOST — IP of the government server
# DEPLOY_USER — SSH user on the server
# DEPLOY_SSH_KEY — Private SSH key for deployment

# =============================================================================
# DEPLOYMENT — Backend on Railway · Frontend on Netlify
# =============================================================================
#
# ── Backend (Railway) ────────────────────────────────────────────────────────
# Service Railway → Root Directory: backend/ → utilise backend/railway.toml
#
#   DATABASE_URL    = sqlite:/app/data/nutriid.db?mode=rwc
#   JWT_SECRET      = <openssl rand -hex 64>
#   RUST_ENV        = production
#   RUST_LOG        = info
#   ALLOWED_ORIGIN  = https://<ton-site>.netlify.app,https://nutriid.ci
#                     ↑ une ou plusieurs origines séparées par des virgules
#   ANTHROPIC_API_KEY = <ta clé Anthropic>
#   POLYGON_RPC_URL = https://rpc-amoy.polygon.technology
#   POLYGON_CHAIN_ID= 80002
#   RELAYER_PRIVATE_KEY        = <clé privée relayer>
#   HEALTH_ID_CONTRACT_ADDRESS = <adresse contrat déployé>
#
#   Volume Railway : monter un volume sur /app/data  (SQLite persistance)
#
# ── Frontend (Netlify) ───────────────────────────────────────────────────────
# Netlify Dashboard → Site → Environment Variables (build-time) :
#
#   VITE_API_URL = https://<ton-backend>.up.railway.app
#
#   IMPORTANT : la variable doit être disponible à BUILD TIME pour que Vite
#   l'injecte dans le bundle. Dans Netlify, cocher
#   "Available during build" (pas seulement runtime).
#
# La config de build Netlify est dans netlify.toml à la racine du repo.
#   base    = "frontend"
#   command = "npm run build"
#   publish = "dist"
