# Nutri-ID — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control!

# ── PostgreSQL ──────────────────────────────────────
POSTGRES_USER=nutriid_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=nutriid_national_db

# ── Rust Backend ─────────────────────────────────────
RUST_LOG=info
JWT_SECRET=a_very_long_random_secret_at_least_64_chars_long_change_me

# ── Blockchain / Polygon Amoy Testnet ────────────────
# Get a free Alchemy or Infura RPC URL for Polygon Amoy (chain ID: 80002)
POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGON_CHAIN_ID=80002
# The server-side relayer wallet private key (just for minting, holds minimal MATIC)
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_PRIVATE_KEY
# Deployed smart contract address (update after running: npx hardhat run scripts/deploy.js --network amoy)
HEALTH_ID_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# ── IPFS / Pinata ──────────────────────────────────
# Create a free account at https://pinata.cloud — get keys from API Keys section
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_api_key

# ── SSL / Production Domain ────────────────────────
# Only needed for production deployment; update nginx.conf with your domain
DOMAIN=nutriid.ci

# ── GitHub Actions Secrets (set in Settings → Secrets, not here) ──────────
# DEPLOY_HOST — IP of the government server
# DEPLOY_USER — SSH user on the server
# DEPLOY_SSH_KEY — Private SSH key for deployment
